@model RegistroModelo
@{
    ViewData["Title"] = "Registro";
}

<div class="caja centrado">
    <div class="encabezado">
        <img src="~/img/logo-univalle.png" alt="Logo Univalle" />
        <h1>Crear cuenta</h1>
        <span class="minutos">Es gratis y te inscribes como Suscriptor</span>
    </div>

    <form asp-action="Registro" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="campo">
            <label asp-for="Nombre">Nombre completo</label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Email">Correo</label>
            <input asp-for="Email" placeholder="tucorreo@ejemplo.com" />
            <span asp-validation-for="Email" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" />
            <small class="minutos">Mínimo 8 caracteres, con mayúscula, minúscula y número.</small>
            <span asp-validation-for="Password" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Confirmacion">Repetir contraseña</label>
            <input asp-for="Confirmacion" />
            <span asp-validation-for="Confirmacion" class="error"></span>
        </div>

        <button class="boton" type="submit">Crear cuenta</button>
    </form>

    <p class="pie">¿Ya tienes cuenta? <a asp-action="Ingresar">Ingresa</a></p>
</div>
