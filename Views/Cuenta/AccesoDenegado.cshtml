@{ ViewData["Title"] = "Acceso restringido"; }
<div class="error-page panel">
    <span class="page-code">Acceso restringido · 403</span>
    <h1>Este contenido necesita permiso.</h1>
    <p>Para leer una lección debes estar inscrito en su curso. Si el curso fue retirado, estará disponible cuando vuelva a publicarse.</p>
    <a class="button button-primary" asp-controller="Cursos" asp-action="Index">Ir al catálogo</a>
</div>
