@model LoginModelo
@{
    ViewData["Title"] = "Ingresar";
}

<div class="caja centrado">
    <div class="encabezado">
        <img src="~/img/logo-univalle.png" alt="Logo Univalle" />
        <h1>Bienvenido</h1>
        <span class="minutos">Ingresa con tu cuenta</span>
    </div>

    <form asp-action="Ingresar" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="campo">
            <label asp-for="Email">Correo</label>
            <input asp-for="Email" placeholder="tucorreo@ejemplo.com" />
            <span asp-validation-for="Email" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" />
            <span asp-validation-for="Password" class="error"></span>
        </div>

        <button class="boton" type="submit">Ingresar</button>
    </form>

    <p class="pie">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>
</div>
