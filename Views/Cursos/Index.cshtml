@model List<Curso>
@{
    ViewData["Title"] = "Inicio";
}

@* bienvenida *@
<section class="portada">
    <div class="portada-texto">
        <h1>Aprende algo nuevo con Univalle</h1>
        <p>Microcursos y tutoriales técnicos gratuitos para estudiantes, docentes, personal administrativo y toda la comunidad.</p>

        <a class="boton" href="#cursos">Ver cursos</a>
        @if (!User.Identity!.IsAuthenticated)
        {
            <a class="boton boton-borde" asp-controller="Cuenta" asp-action="Registro">Crear cuenta gratis</a>
        }
    </div>
    <img class="portada-logo" src="~/img/logo-univalle.png" alt="Logo Univalle" />
</section>

@* pasos *@
<section class="pasos">
    <div class="paso">
        <span class="paso-numero">1</span>
        <h3>Regístrate</h3>
        <p>Crea tu cuenta gratis en un minuto.</p>
    </div>
    <div class="paso">
        <span class="paso-numero">2</span>
        <h3>Inscríbete</h3>
        <p>Elige un curso del catálogo.</p>
    </div>
    <div class="paso">
        <span class="paso-numero">3</span>
        <h3>Aprende</h3>
        <p>Lee las lecciones y sigue tu progreso.</p>
    </div>
</section>

@* catalogo *@
<h2 id="cursos" class="titulo-seccion">Cursos disponibles</h2>
<p class="subtitulo">@Model.Count @(Model.Count == 1 ? "curso encontrado" : "cursos publicados")</p>

<form class="filtros" method="get" asp-action="Index">
    <input type="search" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por título o tema..." aria-label="Buscar cursos" />
    <select name="categoria" aria-label="Filtrar por categoría">
        <option value="">Todas las categorías</option>
        @foreach (var cat in OpcionesCurso.Categorias)
        {
            <option value="@cat" selected="@((string?)ViewBag.Categoria == cat)">@cat</option>
        }
    </select>
    <button class="boton" type="submit">Filtrar</button>
    @if (!string.IsNullOrEmpty((string?)ViewBag.Buscar) || !string.IsNullOrEmpty((string?)ViewBag.Categoria))
    {
        <a class="boton boton-secundario" asp-action="Index">Limpiar</a>
    }
</form>

@if (Model.Count == 0)
{
    @if (!string.IsNullOrEmpty((string?)ViewBag.Buscar) || !string.IsNullOrEmpty((string?)ViewBag.Categoria))
    {
        <div class="caja">No se encontraron cursos con esos filtros. <a asp-action="Index">Ver todos los cursos</a></div>
    }
    else
    {
        <div class="caja">Todavía no hay cursos publicados.</div>
    }
}

<div class="grilla">
    @foreach (var curso in Model)
    {
        <div class="tarjeta">
            @* inicial del curso *@
            <div class="tarjeta-cabecera">@curso.Titulo.Substring(0, 1)</div>

            <div class="etiquetas">
                <span class="etiqueta">@curso.Categoria</span>
                <span class="etiqueta etiqueta-gris">@curso.Nivel</span>
            </div>
            <h3>@curso.Titulo</h3>
            <p>@curso.Descripcion</p>
            <small class="minutos">
                @curso.Lecciones.Count lecciones · @curso.Lecciones.Sum(l => l.DuracionMinutos) min
            </small>
            <a class="boton" asp-action="Detalle" asp-route-id="@curso.Id">Ver curso</a>
        </div>
    }
</div>
