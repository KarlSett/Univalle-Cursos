@model DetalleCursoModelo
@{
    var curso = Model.Curso;
    ViewData["Title"] = curso.Titulo;
    int total = curso.Lecciones.Count;
    int porcentaje = total == 0 ? 0 : Model.Completadas.Count * 100 / total;
}

<a class="volver" asp-action="Index">← Volver al catálogo</a>

<div class="dos-columnas">
    <div>
        <div class="caja">
            <div class="etiquetas">
                <span class="etiqueta">@curso.Categoria</span>
                <span class="etiqueta etiqueta-gris">@curso.Nivel</span>
                @if (!curso.Publicado)
                {
                    <span class="etiqueta etiqueta-gris">Borrador</span>
                }
            </div>
            <h1>@curso.Titulo</h1>
            <p>@curso.Descripcion</p>
        </div>

        <div class="caja">
            <h2>Lecciones</h2>
            <ol class="lista-lecciones">
                @foreach (var leccion in curso.Lecciones)
                {
                    <li>
                        <span>
                            @leccion.Orden.
                            @* enlace solo para inscritos, el servidor igual verifica *@
                            @if (Model.Inscrito)
                            {
                                <a asp-controller="Lecciones" asp-action="Leer" asp-route-id="@leccion.Id">@leccion.Titulo</a>
                            }
                            else
                            {
                                @leccion.Titulo
                            }
                        </span>
                        @if (Model.Completadas.Contains(leccion.Id))
                        {
                            <span class="completada">✔ Completada</span>
                        }
                        else
                        {
                            <span class="minutos">@leccion.DuracionMinutos min</span>
                        }
                    </li>
                }
            </ol>
        </div>
    </div>

    <div class="caja">
        <p><strong>Nivel:</strong> @curso.Nivel</p>
        <p><strong>Duración:</strong> @curso.Lecciones.Sum(l => l.DuracionMinutos) minutos</p>
        <p><strong>Lecciones:</strong> @total</p>
        <p><strong>Precio:</strong> Gratis</p>

        @if (Model.Inscrito)
        {
            <p><strong>Tu progreso:</strong> @porcentaje%</p>
            <div class="barra"><div style="width: @porcentaje%"></div></div>
            <small class="minutos">@Model.Completadas.Count de @total lecciones completadas</small>
        }
        else if (User.IsInRole("Administrador"))
        {
            <a class="boton" asp-controller="Admin" asp-action="Lecciones" asp-route-id="@curso.Id">Gestionar lecciones</a>
        }
        else if (User.IsInRole("Suscriptor"))
        {
            <form asp-action="Inscribirse" asp-route-id="@curso.Id" method="post">
                <button class="boton" type="submit">Inscribirme gratis</button>
            </form>
        }
        else
        {
            <p>Para ver las lecciones debes crear una cuenta e inscribirte.</p>
            <a class="boton" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
            <a class="boton boton-secundario" asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a>
        }
    </div>
</div>
