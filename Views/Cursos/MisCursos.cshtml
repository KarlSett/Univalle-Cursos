@model List<MiCursoModelo>
@{
    ViewData["Title"] = "Mis cursos";
}

<h1>Mis cursos</h1>
<p class="subtitulo">Los cursos en los que estás inscrito y tu progreso.</p>

@if (Model.Count == 0)
{
    <div class="caja">
        Aún no te inscribiste en ningún curso.
        <a asp-action="Index">Ver el catálogo</a>
    </div>
}

<div class="grilla">
    @foreach (var item in Model)
    {
        <div class="tarjeta">
            <div class="etiquetas">
                <span class="etiqueta">@item.Curso.Categoria</span>
                @if (!item.Curso.Publicado)
                {
                    <span class="etiqueta etiqueta-gris">Retirado</span>
                }
            </div>
            <h3>@item.Curso.Titulo</h3>
            <div>
                <div class="barra"><div style="width: @item.Porcentaje%"></div></div>
                <small class="minutos">@item.Completadas de @item.Total lecciones · @item.Porcentaje%</small>
            </div>
            @if (item.Curso.Publicado)
            {
                <a class="boton" asp-action="Detalle" asp-route-id="@item.Curso.Id">Continuar</a>
            }
        </div>
    }
</div>
