@model LeerLeccionModelo
@{
    ViewData["Title"] = Model.Leccion.Titulo;
    int total = Model.Lecciones.Count;
    int porcentaje = total == 0 ? 0 : Model.Completadas.Count * 100 / total;
    bool completada = Model.Completadas.Contains(Model.Leccion.Id);

    // anterior y siguiente
    var anterior = Model.Lecciones.LastOrDefault(l => l.Orden < Model.Leccion.Orden);
    var siguiente = Model.Lecciones.FirstOrDefault(l => l.Orden > Model.Leccion.Orden);
}

<a class="volver" asp-controller="Cursos" asp-action="Detalle" asp-route-id="@Model.Leccion.CursoId">← @Model.Leccion.Curso.Titulo</a>

<div class="dos-columnas">
    <div class="caja">
        <small class="minutos">Lección @Model.Leccion.Orden de @total · @Model.Leccion.DuracionMinutos min</small>
        <h1>@Model.Leccion.Titulo</h1>

        @* texto escapado, no ejecuta html *@
        <div class="contenido-leccion">@Model.Leccion.Contenido</div>

        <hr />
        <div class="acciones">
            @if (completada)
            {
                <span class="completada">✔ Ya completaste esta lección</span>
            }
            else
            {
                <form asp-action="Completar" asp-route-id="@Model.Leccion.Id" method="post">
                    <button class="boton" type="submit">Marcar como completada</button>
                </form>
            }
        </div>
        <br />
        <div class="acciones">
            @if (anterior != null)
            {
                <a class="boton boton-secundario" asp-action="Leer" asp-route-id="@anterior.Id">← Anterior</a>
            }
            @if (siguiente != null)
            {
                <a class="boton boton-secundario" asp-action="Leer" asp-route-id="@siguiente.Id">Siguiente →</a>
            }
        </div>
    </div>

    <div class="caja">
        <h3>Progreso: @porcentaje%</h3>
        <div class="barra"><div style="width: @porcentaje%"></div></div>
        <ol class="lista-lecciones">
            @foreach (var leccion in Model.Lecciones)
            {
                <li class="@(leccion.Id == Model.Leccion.Id ? "actual" : "")">
                    <a asp-action="Leer" asp-route-id="@leccion.Id">@leccion.Orden. @leccion.Titulo</a>
                    @if (Model.Completadas.Contains(leccion.Id))
                    {
                        <span class="completada">✔</span>
                    }
                </li>
            }
        </ol>
    </div>
</div>
