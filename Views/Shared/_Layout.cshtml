<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Univalle Cursos</title>
    <link rel="icon" href="~/img/logo-univalle.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-contenido">
            <a class="logo" asp-controller="Cursos" asp-action="Index">
                <img src="~/img/logo-univalle.png" alt="Logo Univalle" />
                Univalle Cursos
            </a>

            <nav class="menu">
                <a asp-controller="Cursos" asp-action="Index">Catálogo</a>

                @if (User.IsInRole("Suscriptor"))
                {
                    <a asp-controller="Cursos" asp-action="MisCursos">Mis cursos</a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Admin" asp-action="Index">Administración</a>
                }

                @if (User.Identity!.IsAuthenticated)
                {
                    <span class="usuario">@User.Identity.Name</span>
                    <form class="en-linea" asp-controller="Cuenta" asp-action="Salir" method="post">
                        <button class="boton boton-secundario boton-chico" type="submit">Salir</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a>
                    <a class="boton boton-chico" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                }
            </nav>
        </div>
    </header>

    <main class="contenedor">
        @* mensajes de tempdata *@
        @if (TempData["Exito"] != null)
        {
            <div class="mensaje mensaje-exito">@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mensaje mensaje-error">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        Universidad Privada del Valle - Portal de Microcursos y Tutoriales
    </footer>
</body>
</html>
