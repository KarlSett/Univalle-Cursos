@model Curso
@{
    ViewData["Title"] = "Inscritos";
    int total = Model.Lecciones.Count;
}

<a class="volver" asp-action="Index">← Volver</a>

<h1>Inscritos en: @Model.Titulo</h1>

@if (Model.Inscripciones.Count == 0)
{
    <div class="caja">Nadie se inscribió todavía en este curso.</div>
}
else
{
    <div class="tabla-contenedor">
        <table>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Fecha de inscripción</th>
                <th>Progreso</th>
            </tr>
            @foreach (var inscripcion in Model.Inscripciones.OrderBy(i => i.FechaInscripcion))
            {
                int completadas = inscripcion.LeccionesCompletadas.Count;
                <tr>
                    <td>@inscripcion.Usuario.Nombre</td>
                    <td>@inscripcion.Usuario.Email</td>
                    <td>@inscripcion.FechaInscripcion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@completadas de @total lecciones</td>
                </tr>
            }
        </table>
    </div>
}
