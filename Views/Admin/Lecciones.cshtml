@model Curso
@{
    ViewData["Title"] = "Lecciones";
}

<a class="volver" asp-action="Index">← Volver</a>

<h1>Lecciones de: @Model.Titulo</h1>
<p>
    <a class="boton" asp-action="CrearLeccion" asp-route-cursoId="@Model.Id">+ Nueva lección</a>
    <a class="boton boton-secundario" asp-controller="Cursos" asp-action="Detalle" asp-route-id="@Model.Id">Ver página del curso</a>
</p>

@if (Model.Lecciones.Count == 0)
{
    <div class="caja">Este curso todavía no tiene lecciones.</div>
}
else
{
    <div class="tabla-contenedor">
        <table>
            <tr>
                <th>Orden</th>
                <th>Título</th>
                <th>Minutos</th>
                <th>Acciones</th>
            </tr>
            @foreach (var leccion in Model.Lecciones)
            {
                <tr>
                    <td>@leccion.Orden</td>
                    <td>@leccion.Titulo</td>
                    <td>@leccion.DuracionMinutos</td>
                    <td>
                        <div class="acciones">
                            @* -1 sube, +1 baja *@
                            <form class="en-linea" asp-action="MoverLeccion" asp-route-id="@leccion.Id" asp-route-direccion="-1" method="post">
                                <button class="boton boton-chico boton-secundario" type="submit">↑</button>
                            </form>
                            <form class="en-linea" asp-action="MoverLeccion" asp-route-id="@leccion.Id" asp-route-direccion="1" method="post">
                                <button class="boton boton-chico boton-secundario" type="submit">↓</button>
                            </form>

                            <a class="boton boton-chico boton-secundario" asp-action="EditarLeccion" asp-route-id="@leccion.Id">Editar</a>

                            <form class="en-linea" asp-action="EliminarLeccion" asp-route-id="@leccion.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar esta lección?');">
                                <button class="boton boton-chico boton-peligro" type="submit">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </table>
    </div>
}
