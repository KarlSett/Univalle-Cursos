@model List<TarjetaCurso>
@{ ViewData["Title"] = "Administración"; }
<div class="page-heading">
    <div>
        <h1>Un espacio para enseñar.</h1>
        <p>Organiza los cursos y acompaña el aprendizaje.</p>
    </div>
    <a class="button button-primary" asp-action="Crear">
        <svg class="icon">
            <use href="/img/icons.svg#plus" />
        </svg>Crear curso</a>
</div>
<div class="stats-strip">
    <div>
        <strong>@Model.Count</strong>
        <span>Cursos creados</span>
    </div>
    <div>
        <strong>@Model.Count(c => c.Publicado)</strong>
        <span>Cursos publicados</span>
    </div>
    <div>
        <strong>@Model.Sum(c => c.Inscritos)</strong>
        <span>Inscripciones registradas</span>
    </div>
</div>
<div class="section-heading">
    <h2>Gestionar cursos</h2>
    <span class="muted">@Model.Count cursos</span>
</div>
@if (Model.Count == 0)
{
<div class="empty-state">
    <h2>Comparte lo que sabes</h2>
    <p>Crea tu primer curso y agrega sus lecciones antes de publicarlo.</p>
    <a class="button button-secondary" asp-action="Crear">Crear primer curso</a>
</div>
}
else
{
<div class="admin-table-wrapper">
    <table class="admin-table">
        <caption class="sr-only">Cursos y acciones de administración</caption>
        <thead>
            <tr>
                <th>Curso</th>
                <th>Estado</th>
                <th class="num">Lecciones</th>
                <th class="num">Inscritos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var curso in Model)
            {
            <tr>
                <td>
                    <div class="table-art">
                        <partial name="_Portada" model="curso.Portada" />
                        <div class="table-title">@curso.Titulo<small>@curso.Categoria · @curso.Nivel</small>
                        </div>
                    </div>
                </td>
                <td>
                    <form class="table-status-form" asp-action="Publicar" asp-route-id="@curso.Id" method="post">
                        <button type="submit" class="badge @(curso.Publicado ? "badge-success" : "")" aria-label="@(curso.Publicado ? "Retirar" : "Publicar") @curso.Titulo" title="@(curso.Publicado ? "Retirar del catálogo" : "Publicar curso")">@(curso.Publicado ? "Publicado" : "Borrador")</button>
                    </form>
                </td>
                <td class="num">@curso.Lecciones</td>
                <td class="num">
                    <a class="text-link" asp-action="Inscritos" asp-route-id="@curso.Id">@curso.Inscritos<span class="sr-only"> inscritos en @curso.Titulo</span>
                    </a>
                </td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Editar" asp-route-id="@curso.Id">Editar<span class="sr-only"> @curso.Titulo</span>
                        </a>
                        <a asp-action="Lecciones" asp-route-id="@curso.Id">Lecciones<span class="sr-only"> de @curso.Titulo</span>
                        </a>
                        <form asp-action="Eliminar" asp-route-id="@curso.Id" method="post" data-confirmar="¿Eliminar «@curso.Titulo»? También se borrarán sus lecciones, inscripciones y progreso. Esta acción no se puede deshacer.">
                            <button type="submit">Eliminar<span class="sr-only"> @curso.Titulo</span>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
<p class="edit-help">Selecciona el estado de un curso para publicarlo o retirarlo del catálogo. Al retirarlo, se conserva el progreso de sus estudiantes.</p>
}
