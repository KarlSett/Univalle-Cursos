@model List<Curso>
@{
    ViewData["Title"] = "Administración";
}

<h1>Administración de cursos</h1>
<p><a class="boton" asp-action="Crear">+ Nuevo curso</a></p>

<div class="tabla-contenedor">
    <table>
        <tr>
            <th>Curso</th>
            <th>Nivel</th>
            <th>Lecciones</th>
            <th>Inscritos</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
        @foreach (var curso in Model)
        {
            <tr>
                <td>@curso.Titulo</td>
                <td>@curso.Nivel</td>
                <td>@curso.Lecciones.Count</td>
                <td>@curso.Inscripciones.Count</td>
                <td>@(curso.Publicado ? "Publicado" : "Borrador")</td>
                <td>
                    <div class="acciones">
                        <a class="boton boton-chico" asp-action="Lecciones" asp-route-id="@curso.Id">Lecciones</a>
                        <a class="boton boton-chico boton-secundario" asp-action="Inscritos" asp-route-id="@curso.Id">Inscritos</a>
                        <a class="boton boton-chico boton-secundario" asp-action="Editar" asp-route-id="@curso.Id">Editar</a>

                        <form class="en-linea" asp-action="CambiarPublicacion" asp-route-id="@curso.Id" method="post">
                            <button class="boton boton-chico boton-secundario" type="submit">
                                @(curso.Publicado ? "Despublicar" : "Publicar")
                            </button>
                        </form>

                        <form class="en-linea" asp-action="Eliminar" asp-route-id="@curso.Id" method="post"
                              onsubmit="return confirm('¿Eliminar el curso con sus lecciones e inscripciones?');">
                            <button class="boton boton-chico boton-peligro" type="submit">Eliminar</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </table>
</div>
