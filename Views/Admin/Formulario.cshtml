@model CursoFormulario
@{
    bool editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar curso" : "Nuevo curso";
}

<a class="volver" asp-action="Index">← Volver</a>

<div class="caja formulario">
    <h1>@ViewData["Title"]</h1>

    <form asp-action="@(editando ? "Editar" : "Crear")" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="campo">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" />
            <span asp-validation-for="Titulo" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Descripcion">Descripción</label>
            <textarea asp-for="Descripcion" rows="4"></textarea>
            <span asp-validation-for="Descripcion" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Categoria">Categoría</label>
            <select asp-for="Categoria" asp-items="@(new SelectList(OpcionesCurso.Categorias))"></select>
        </div>

        <div class="campo">
            <label asp-for="Nivel">Nivel</label>
            <select asp-for="Nivel" asp-items="@(new SelectList(OpcionesCurso.Niveles))"></select>
        </div>

        <button class="boton" type="submit">Guardar</button>
    </form>
</div>
