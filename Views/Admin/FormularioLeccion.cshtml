@model LeccionFormulario
@{
    bool editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar lección" : "Nueva lección";
}

<a class="volver" asp-action="Lecciones" asp-route-id="@Model.CursoId">← Volver a las lecciones</a>

<div class="caja formulario">
    <h1>@ViewData["Title"]</h1>

    <form asp-action="@(editando ? "EditarLeccion" : "CrearLeccion")" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CursoId" type="hidden" />

        <div class="campo">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" />
            <span asp-validation-for="Titulo" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="DuracionMinutos">Duración (minutos)</label>
            <input asp-for="DuracionMinutos" />
            <span asp-validation-for="DuracionMinutos" class="error"></span>
        </div>

        <div class="campo">
            <label asp-for="Contenido">Contenido (texto)</label>
            <textarea asp-for="Contenido" rows="12"></textarea>
            <span asp-validation-for="Contenido" class="error"></span>
        </div>

        <button class="boton" type="submit">Guardar</button>
    </form>
</div>
